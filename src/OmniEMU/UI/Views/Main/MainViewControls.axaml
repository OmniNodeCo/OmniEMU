<UserControl
    x:Class="OmniEMU.Ava.UI.Views.Main.MainViewControls"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:OmniEMU.Ava.UI.Controls"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:helpers="clr-namespace:OmniEMU.Ava.UI.Helpers"
    xmlns:locale="clr-namespace:OmniEMU.Ava.Common.Locale"
    xmlns:viewModels="clr-namespace:OmniEMU.Ava.UI.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="1100"
    d:DesignHeight="74"
    x:DataType="viewModels:MainWindowViewModel">
    <Design.DataContext><viewModels:MainWindowViewModel /></Design.DataContext>

    <Border Padding="18,14" BorderBrush="{DynamicResource OmniBorderBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="18" FontWeight="Bold" Text="Game library" />
                <TextBlock FontSize="9" Foreground="{DynamicResource OmniMutedTextBrush}" Text="YOUR LOCAL COLLECTION" />
            </StackPanel>

            <Border Grid.Column="1" Width="1" Height="32" Margin="18,0" VerticalAlignment="Center" Background="{DynamicResource OmniBorderBrush}" />

            <Grid Grid.Column="2" MaxWidth="420" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <TextBox
                    Name="SearchBox"
                    Classes="omni-search"
                    MinWidth="240"
                    KeyUp="SearchBox_OnKeyUp"
                    Text="{Binding SearchText}"
                    Watermark="Search titles, developers, or IDs…" />
                <TextBlock Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource OmniMutedTextBrush}" IsHitTestVisible="False" Text="⌕" />
            </Grid>

            <StackPanel Grid.Column="3" Margin="16,0,0,0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Button Classes="omni-tool" Width="40" Command="{Binding SetListMode}" IsEnabled="{Binding IsGrid}" ToolTip.Tip="List view">
                    <ui:FontIcon FontFamily="avares://FluentAvalonia/Fonts#Symbols" Glyph="{helpers:GlyphValueConverter List}" />
                </Button>
                <Button Classes="omni-tool" Width="40" Command="{Binding SetGridMode}" IsEnabled="{Binding IsList}" ToolTip.Tip="Grid view">
                    <ui:FontIcon FontFamily="avares://FluentAvalonia/Fonts#Symbols" Glyph="{helpers:GlyphValueConverter Grid}" />
                </Button>
                <DropDownButton Classes="omni-tool" MinWidth="120" Content="{Binding SortName}">
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel MinWidth="210" Margin="4" Spacing="2">
                                <TextBlock Margin="8,4" Classes="section-label" Text="SORT LIBRARY" />
                                <RadioButton Checked="Sort_Checked" Content="{locale:Locale CommonFavorite}" GroupName="Sort" IsChecked="{Binding IsSortedByFavorite, Mode=OneTime}" Tag="Favorite" />
                                <RadioButton Checked="Sort_Checked" Content="{locale:Locale GameListHeaderApplication}" GroupName="Sort" IsChecked="{Binding IsSortedByTitle, Mode=OneTime}" Tag="Title" />
                                <RadioButton Checked="Sort_Checked" Content="{locale:Locale GameListHeaderDeveloper}" GroupName="Sort" IsChecked="{Binding IsSortedByDeveloper, Mode=OneTime}" Tag="Developer" />
                                <RadioButton Checked="Sort_Checked" Content="{locale:Locale GameListHeaderTimePlayed}" GroupName="Sort" IsChecked="{Binding IsSortedByTimePlayed, Mode=OneTime}" Tag="TotalTimePlayed" />
                                <RadioButton Checked="Sort_Checked" Content="{locale:Locale GameListHeaderLastPlayed}" GroupName="Sort" IsChecked="{Binding IsSortedByLastPlayed, Mode=OneTime}" Tag="LastPlayed" />
                                <RadioButton Checked="Sort_Checked" Content="{locale:Locale GameListHeaderFileSize}" GroupName="Sort" IsChecked="{Binding IsSortedBySize, Mode=OneTime}" Tag="FileSize" />
                                <Separator Margin="4,7" />
                                <RadioButton Checked="Order_Checked" Content="{locale:Locale OrderAscending}" GroupName="Order" IsChecked="{Binding IsAscending, Mode=OneTime}" Tag="Ascending" />
                                <RadioButton Checked="Order_Checked" Content="{locale:Locale OrderDescending}" GroupName="Order" IsChecked="{Binding !IsAscending, Mode=OneTime}" Tag="Descending" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <StackPanel Grid.Column="4" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2" IsVisible="{Binding IsGrid}">
                <TextBlock FontSize="8" Foreground="{DynamicResource OmniMutedTextBrush}" Text="CARD SIZE" />
                <controls:SliderScroll
                    Width="105"
                    Height="24"
                    IsSnapToTickEnabled="True"
                    SmallChange="1"
                    Maximum="4"
                    Minimum="1"
                    TickFrequency="1"
                    Value="{Binding GridSizeScale}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
