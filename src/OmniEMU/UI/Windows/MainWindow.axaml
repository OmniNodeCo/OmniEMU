<window:StyleableWindow
    x:Class="OmniEMU.Ava.UI.Windows.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:window="clr-namespace:OmniEMU.Ava.UI.Windows"
    xmlns:viewModels="clr-namespace:OmniEMU.Ava.UI.ViewModels"
    xmlns:helpers="clr-namespace:OmniEMU.Ava.UI.Helpers"
    xmlns:controls="clr-namespace:OmniEMU.Ava.UI.Controls"
    xmlns:main="clr-namespace:OmniEMU.Ava.UI.Views.Main"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    Cursor="{Binding Cursor}"
    Title="{Binding Title}"
    WindowState="{Binding WindowState}"
    Width="{Binding WindowWidth}"
    Height="{Binding WindowHeight}"
    MinWidth="900"
    MinHeight="560"
    d:DesignHeight="760"
    d:DesignWidth="1280"
    x:DataType="viewModels:MainWindowViewModel"
    mc:Ignorable="d"
    WindowStartupLocation="Manual"
    Focusable="True"
    Background="{DynamicResource OmniWindowBrush}">
    <Window.Styles>
        <Style Selector="TitleBar:fullscreen"><Setter Property="Background" Value="#000000" /></Style>
    </Window.Styles>
    <Design.DataContext><viewModels:MainWindowViewModel /></Design.DataContext>
    <Window.Resources><helpers:BitmapArrayValueConverter x:Key="ByteImage" /></Window.Resources>
    <Window.KeyBindings>
        <KeyBinding Gesture="Alt+Return" Command="{Binding ToggleFullscreen}" />
        <KeyBinding Gesture="F11" Command="{Binding ToggleFullscreen}" />
        <KeyBinding Gesture="Ctrl+Cmd+F" Command="{Binding ToggleFullscreen}" />
        <KeyBinding Gesture="F9" Command="{Binding ToggleDockMode}" />
        <KeyBinding Gesture="Escape" Command="{Binding ExitCurrentState}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto">
        <helpers:OffscreenTextBox IsEnabled="False" Opacity="0" Name="HiddenTextBox" IsHitTestVisible="False" IsTabStop="False" />

        <!-- Branded application bar -->
        <Border
            Grid.Row="0"
            Height="64"
            Padding="18,8"
            Background="{DynamicResource OmniPanelBrush}"
            BorderBrush="{DynamicResource OmniBorderBrush}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding ShowMenuAndStatusBar}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Image Width="38" Height="38" Source="resm:OmniEMU.UI.Common.Resources.Logo_OmniEMU.png?assembly=OmniEMU.UI.Common" />
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock FontSize="17" FontWeight="Bold" LetterSpacing=".7" Text="OmniEMU" />
                        <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource OmniMutedTextBrush}" LetterSpacing="1.2" Text="BY OMNINODECO" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Height="28" Margin="19,0" Background="{DynamicResource OmniBorderBrush}" />
                <StackPanel
                    Name="MenuBar"
                    Grid.Column="2"
                    MinHeight="35"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <main:MainMenuBarView Name="MenuBarView" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Border Padding="10,6" Background="#1835F3CE" BorderBrush="#4035F3CE" BorderThickness="1" CornerRadius="14">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="#35F3CE" />
                            <TextBlock FontSize="9" FontWeight="Bold" Foreground="#35CFAF" Text="SYSTEM READY" />
                        </StackPanel>
                    </Border>
                    <Button Classes="omni-tool" Command="{Binding ToggleFullscreen}" ToolTip.Tip="Fullscreen (F11)">
                        <TextBlock FontSize="15" Text="⛶" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <!-- Fast-access navigation rail -->
            <Border
                Grid.Column="0"
                Width="72"
                Padding="11,16"
                Background="{DynamicResource OmniPanelBrush}"
                BorderBrush="{DynamicResource OmniBorderBrush}"
                BorderThickness="0,0,1,0"
                IsVisible="{Binding EnableNonGameRunningControls}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Spacing="9">
                        <Button Classes="rail-button accent" ToolTip.Tip="Game library">
                            <ui:SymbolIcon Symbol="StarFilled" />
                        </Button>
                        <Button Classes="rail-button" Command="{Binding OpenFile}" ToolTip.Tip="Open game file">
                            <ui:SymbolIcon Symbol="Help" />
                        </Button>
                        <Button Classes="rail-button" Command="{Binding OpenFolder}" ToolTip.Tip="Open unpacked game">
                            <ui:SymbolIcon Symbol="OpenFolder" />
                        </Button>
                        <Button Classes="rail-button" Command="{Binding ManageProfiles}" ToolTip.Tip="User profiles">
                            <ui:SymbolIcon Symbol="Edit" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="9">
                        <Border Width="36" Height="1" Margin="6,0" Background="{DynamicResource OmniBorderBrush}" />
                        <Button Classes="rail-button" Command="{Binding OpenOmniEMUFolder}" ToolTip.Tip="Open OmniEMU data folder">
                            <ui:SymbolIcon Symbol="OpenFolder" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl
                Name="MainContent"
                Grid.Column="1"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsVisible="{Binding ShowContent}">
                <Border
                    Name="GameLibrary"
                    Margin="18"
                    Background="{DynamicResource OmniPanelBrush}"
                    BorderBrush="{DynamicResource OmniBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <main:MainViewControls Name="ViewControls" Grid.Row="0" />
                        <controls:ApplicationListView
                            x:Name="ApplicationList"
                            Grid.Row="1"
                            Margin="8,0,8,8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsVisible="{Binding IsList}" />
                        <controls:ApplicationGridView
                            x:Name="ApplicationGrid"
                            Grid.Row="1"
                            Margin="8,0,8,8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsVisible="{Binding IsGrid}" />
                    </Grid>
                </Border>
            </ContentControl>

            <!-- Shader/PPTC loading experience -->
            <Grid
                Name="LoadingView"
                Grid.ColumnSpan="2"
                Background="#E6070B12"
                IsVisible="{Binding ShowLoadProgress}"
                ZIndex="1000">
                <Border
                    Width="720"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource OmniPanelBrush}"
                    BorderBrush="{DynamicResource OmniBorderBrush}"
                    BorderThickness="1"
                    BoxShadow="0 24 60 0 #90000000"
                    CornerRadius="24">
                    <Grid ColumnDefinitions="190,*">
                        <Border Width="170" Height="170" Padding="5" Background="{DynamicResource OmniSubtleBrush}" CornerRadius="22">
                            <Image Source="{Binding SelectedIcon, Converter={StaticResource ByteImage}}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="28,4,0,0" VerticalAlignment="Center" Spacing="13">
                            <TextBlock Classes="section-label" Foreground="#35F3CE" Text="PREPARING EMULATION" />
                            <TextBlock FontSize="27" FontWeight="Bold" Text="{Binding LoadHeading}" TextWrapping="Wrap" MaxWidth="440" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource OmniMutedTextBrush}" Text="{Binding CacheLoadStatus}" />
                            <Border Height="9" Margin="0,5,0,0" Background="{DynamicResource OmniSubtleBrush}" CornerRadius="5" ClipToBounds="True">
                                <ProgressBar
                                    Height="9"
                                    Foreground="{Binding ProgressBarForegroundColor}"
                                    IsIndeterminate="{Binding IsLoadingIndeterminate}"
                                    Maximum="{Binding ProgressMaximum}"
                                    Minimum="0"
                                    Value="{Binding ProgressValue}" />
                            </Border>
                            <TextBlock FontSize="10" Foreground="{DynamicResource OmniMutedTextBrush}" Text="Building caches now reduces stutter during gameplay." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <main:MainStatusBarView Name="StatusBarView" Grid.Row="2" />
    </Grid>
</window:StyleableWindow>
