<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="SystemAccentColor">#6D7CFF</Color>
            <Color x:Key="SystemAccentColorDark1">#5968E8</Color>
            <Color x:Key="SystemAccentColorDark2">#4654C9</Color>
            <Color x:Key="SystemAccentColorDark3">#35419F</Color>
            <Color x:Key="SystemAccentColorLight1">#8995FF</Color>
            <Color x:Key="SystemAccentColorLight2">#A8B0FF</Color>
            <Color x:Key="SystemAccentColorLight3">#CCD0FF</Color>
            <Color x:Key="ThemeAccentColor4">#EDF0F7</Color>
            <Color x:Key="DataGridSelectionColor">#6D7CFF</Color>
            <Color x:Key="ThemeContentBackgroundColor">#F4F6FA</Color>
            <Color x:Key="ThemeControlBorderColor">#DDE2EB</Color>
            <Color x:Key="TextOnAccentFillColorPrimary">#FFFFFF</Color>
            <Color x:Key="SystemChromeWhiteColor">#FFFFFF</Color>
            <Color x:Key="ThemeForegroundColor">#101522</Color>
            <Color x:Key="MenuFlyoutPresenterBorderColor">#D8DEE9</Color>
            <Color x:Key="AppListBackgroundColor">#F9FAFC</Color>
            <Color x:Key="AppListHoverBackgroundColor">#E9ECF5</Color>
            <Color x:Key="SecondaryTextColor">#687287</Color>
            <Color x:Key="VsyncEnabled">#21C997</Color>
            <Color x:Key="VsyncDisabled">#FF6474</Color>
            <SolidColorBrush x:Key="DataGridSelectionBackgroundBrush" Color="{DynamicResource DataGridSelectionColor}" />
            <SolidColorBrush x:Key="ThemeAccentColorBrush" Color="{DynamicResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ThemeAccentBrush4" Color="{DynamicResource ThemeAccentColor4}" />
            <SolidColorBrush x:Key="OmniWindowBrush" Color="#F0F2F7" />
            <SolidColorBrush x:Key="OmniPanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OmniSubtleBrush" Color="#F7F8FB" />
            <SolidColorBrush x:Key="OmniBorderBrush" Color="#DDE2EB" />
            <SolidColorBrush x:Key="OmniMutedTextBrush" Color="#687287" />
            <LinearGradientBrush x:Key="OmniHeroBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#182A47" />
                <GradientStop Offset="0.5" Color="#283A70" />
                <GradientStop Offset="1" Color="#6348A8" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#6D7CFF</Color>
            <Color x:Key="SystemAccentColorDark1">#5968E8</Color>
