                <GradientStop Offset="1" Color="#6348A8" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="ControlFillColorSecondary">#222B3B</Color>
            <Color x:Key="SystemAccentColor">#7E8CFF</Color>
            <Color x:Key="SystemAccentColorDark1">#6878F0</Color>
            <Color x:Key="SystemAccentColorDark2">#5261CB</Color>
            <Color x:Key="SystemAccentColorDark3">#3E4A9E</Color>
            <Color x:Key="SystemAccentColorLight1">#98A3FF</Color>
            <Color x:Key="SystemAccentColorLight2">#B3BAFF</Color>
            <Color x:Key="SystemAccentColorLight3">#D3D7FF</Color>
            <Color x:Key="ThemeAccentColor4">#17202D</Color>
            <Color x:Key="DataGridSelectionColor">#7E8CFF</Color>
            <Color x:Key="ThemeContentBackgroundColor">#0A0F18</Color>
            <Color x:Key="ThemeControlBorderColor">#202B3A</Color>
            <Color x:Key="TextOnAccentFillColorPrimary">#FFFFFF</Color>
            <Color x:Key="SystemChromeWhiteColor">#FFFFFF</Color>
            <Color x:Key="ThemeForegroundColor">#F3F6FB</Color>
            <Color x:Key="MenuFlyoutPresenterBorderColor">#273345</Color>
            <Color x:Key="AppListBackgroundColor">#0D131E</Color>
            <Color x:Key="AppListHoverBackgroundColor">#182232</Color>
            <Color x:Key="SecondaryTextColor">#8D99AC</Color>
            <Color x:Key="VsyncEnabled">#35F3CE</Color>
            <Color x:Key="VsyncDisabled">#FF6474</Color>
            <SolidColorBrush x:Key="DataGridSelectionBackgroundBrush" Color="{DynamicResource DataGridSelectionColor}" />
            <SolidColorBrush x:Key="ThemeAccentColorBrush" Color="{DynamicResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ThemeAccentBrush4" Color="{DynamicResource ThemeAccentColor4}" />
            <SolidColorBrush x:Key="OmniWindowBrush" Color="#070B12" />
            <SolidColorBrush x:Key="OmniPanelBrush" Color="#0D131E" />
            <SolidColorBrush x:Key="OmniSubtleBrush" Color="#101824" />
            <SolidColorBrush x:Key="OmniBorderBrush" Color="#202B3A" />
            <SolidColorBrush x:Key="OmniMutedTextBrush" Color="#8D99AC" />
            <LinearGradientBrush x:Key="OmniHeroBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#0D2530" />
